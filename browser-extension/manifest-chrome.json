{
  "manifest_version": 3,
  "name": "Anchoa Download Manager",
  "version": "1.0.0",
  "description": "Integrasikan unduhan browser dengan Anchoa",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anchoa Download Manager"
  }
}
