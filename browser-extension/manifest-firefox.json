{
  "manifest_version": 2,
  "name": "Anchoa Download Manager",
  "version": "1.0.0",
  "description": "Integrasikan unduhan browser dengan Anchoa",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Anchoa Download Manager"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "downloads@anchoa.local"
    }
  }
}
