---
import { id as copy } from '../content/translations';
---

<section class="band" id="cara-kerja" data-depth="60" aria-labelledby="h-how">
  <div class="wrap">
    <div class="band-head">
      <div class="depth">
        −60 m<small data-i18n="zone.epi" set:html={copy['zone.epi']} />
      </div>
      <div>
        <h2 id="h-how" data-i18n="how.title" set:html={copy['how.title']} />
        <p data-i18n="how.lead" set:html={copy['how.lead']} />
      </div>
    </div>
    <div class="flow reveal">
      <div class="node">
        <span class="tag" data-i18n="how.n1tag" set:html={copy['how.n1tag']} />
        <h3>Anchoa App</h3>
        <ul>
          <li data-i18n="how.n1a" set:html={copy['how.n1a']} />
          <li data-i18n="how.n1b" set:html={copy['how.n1b']} />
          <li data-i18n="how.n1c" set:html={copy['how.n1c']} />
        </ul>
      </div>
      <div class="link">
        <svg viewBox="0 0 100 14" preserveAspectRatio="none">
          <line class="dash" x1="0" y1="7" x2="100" y2="7" />
        </svg>
        <span data-i18n="how.l1" set:html={copy['how.l1']} />
      </div>
      <div class="node">
        <span class="tag" data-i18n="how.n2tag" set:html={copy['how.n2tag']} />
        <h3>SQLite</h3>
        <ul>
          <li data-i18n="how.n2a" set:html={copy['how.n2a']} />
          <li data-i18n="how.n2b" set:html={copy['how.n2b']} />
          <li data-i18n="how.n2c" set:html={copy['how.n2c']} />
        </ul>
      </div>
      <div class="link">
        <svg viewBox="0 0 100 14" preserveAspectRatio="none">
          <line class="dash rev" x1="0" y1="7" x2="100" y2="7" />
        </svg>
        <span data-i18n="how.l2" set:html={copy['how.l2']} />
      </div>
      <div class="node">
        <span class="tag" data-i18n="how.n3tag" set:html={copy['how.n3tag']} />
        <h3 data-i18n="how.n3t" set:html={copy['how.n3t']} />
        <ul>
          <li data-i18n="how.n3a" set:html={copy['how.n3a']} />
          <li data-i18n="how.n3b" set:html={copy['how.n3b']} />
          <li data-i18n="how.n3c" set:html={copy['how.n3c']} />
        </ul>
      </div>
    </div>
    <p class="note" data-i18n="how.note" set:html={copy['how.note']} />
  </div>
</section>
