---
import { id as copy } from '../content/translations';
// 1:1 copy of the design-canvas artboards from Ref/Anchoa.html (desktop + phone).
import replica from './dashboard.html?raw';
---

<div class="shot" id="preview">
  <div class="wrap">
    <Fragment set:html={replica} />
    <p
      class="shot-caption"
      data-i18n="mock.caption"
      set:html={copy['mock.caption']}
    />
  </div>
</div>
