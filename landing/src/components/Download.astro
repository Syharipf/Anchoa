---
import { id as copy } from '../content/translations';
import { site } from '../config/site';
---

<section class="band" id="unduh" data-depth="180" aria-labelledby="h-dl">
  <div class="wrap">
    <div class="band-head">
      <div class="depth">
        −180 m<small data-i18n="zone.epi" set:html={copy['zone.epi']} />
      </div>
      <div>
        <h2 id="h-dl" data-i18n="dl.title" set:html={copy['dl.title']} />
        <p data-i18n="dl.lead" set:html={copy['dl.lead']} />
      </div>
    </div>
    <div class="dl">
      <article class="card main reveal">
        <div style="display:flex;flex-direction:column;gap:10px">
          <span
            class="status ready"
            data-i18n="dl.ready"
            set:html={copy['dl.ready']}
          />
          <h3 data-i18n="dl.archT" set:html={copy['dl.archT']} />
          <p data-i18n="dl.archD" set:html={copy['dl.archD']} />
          <div>
            <a
              class="btn btn-primary js-releases"
              href={site.releases}
              target="_blank"
              rel="noopener"
            >
              <span data-i18n="dl.archBtn" set:html={copy['dl.archBtn']} />
            </a>
          </div>
        </div>
        <div class="cmds">
          {
            site.archCommands.map((command, index) => (
              <div class="cmd">
                <code id={`ca${index + 1}`} tabindex="0">
                  {command}
                </code>
                <button
                  class="copy"
                  type="button"
                  data-copy-target={`ca${index + 1}`}
                  aria-label="Salin perintah instalasi Arch Linux"
                  data-i18n="copy"
                  set:html={copy['copy']}
                />
              </div>
            ))
          }
        </div>
      </article>
      <article class="card reveal">
        <span
          class="status soon"
          data-i18n="dl.soon"
          set:html={copy['dl.soon']}
        />
        <h3 data-i18n="dl.aurT" set:html={copy['dl.aurT']} />
        <p data-i18n="dl.aurD" set:html={copy['dl.aurD']} />
        <div class="cmd">
          <code id="c-aur" tabindex="0">
            {site.aurCommand}
          </code>
          <button
            class="copy"
            type="button"
            data-copy-target="c-aur"
            aria-label="Salin perintah instalasi AUR"
            data-i18n="copy"
            set:html={copy['copy']}
          />
        </div>
      </article>
      <article class="card roadmap reveal">
        <div class="rm-head">
          <h3 data-i18n="rm.title" set:html={copy['rm.title']} />
          <span data-i18n="rm.note" set:html={copy['rm.note']} />
        </div>
        <ol class="route">
          <li class="now">
            <span class="rn"></span>
            <svg class="route-fish" viewBox="-12 -4 22 8" aria-hidden="true">
              <path d="M-7 0C-3-2.4 3-2.6 7 0C3 2.6-3 2.4-7 0ZM-6 0L-10.5-2.8L-9.2 0L-10.5 2.8Z" />
            </svg>
            <b>Arch · CachyOS</b>
            <small data-i18n="rm.s1" set:html={copy['rm.s1']} />
          </li>
        </ol>
      </article>
    </div>
  </div>
</section>
