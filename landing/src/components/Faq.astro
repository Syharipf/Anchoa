---
import { id as copy } from '../content/translations';
---

<section class="band" id="faq" data-depth="200" aria-labelledby="h-faq">
  <div class="wrap">
    <div class="band-head">
      <div class="depth">
        −200 m<small data-i18n="zone.meso" set:html={copy['zone.meso']} />
      </div>
      <div>
        <h2 id="h-faq" data-i18n="faq.title" set:html={copy['faq.title']} />
      </div>
    </div>
    <div class="faq">
      <details>
        <summary data-i18n="q1" set:html={copy['q1']} />
        <p data-i18n="a1" set:html={copy['a1']} />
      </details>
      <details>
        <summary data-i18n="q2" set:html={copy['q2']} />
        <p data-i18n="a2" set:html={copy['a2']} />
      </details>
      <details>
        <summary data-i18n="q3" set:html={copy['q3']} />
        <p data-i18n="a3" set:html={copy['a3']} />
      </details>
      <details>
        <summary data-i18n="q4" set:html={copy['q4']} />
        <p data-i18n="a4" set:html={copy['a4']} />
      </details>
      <details>
        <summary data-i18n="q6" set:html={copy['q6']} />
        <p data-i18n="a6" set:html={copy['a6']} />
      </details>
      <details>
        <summary data-i18n="q5" set:html={copy['q5']} />
        <p data-i18n="a5" set:html={copy['a5']} />
      </details>
    </div>
    <div class="guide reveal" id="penghuni">
      <div class="guide-head">
        <h3 data-i18n="g.title" set:html={copy['g.title']} />
        <p data-i18n="g.lead" set:html={copy['g.lead']} />
      </div>
      <ul>
        <li style="--c:#6F9C7E">
          <b data-i18n="g.n1" set:html={copy['g.n1']} />
          <i>Chelonia mydas</i>
          <span data-i18n="g.d1" set:html={copy['g.d1']} />
        </li>
        <li style="--c:#D9C9F5">
          <b data-i18n="g.n2" set:html={copy['g.n2']} />
          <i>Aurelia aurita</i>
          <span data-i18n="g.d2" set:html={copy['g.d2']} />
        </li>
        <li style="--c:#CFE3EA">
          <b data-i18n="g.n3" set:html={copy['g.n3']} />
          <i>Stolephorus spp.</i>
          <span data-i18n="g.d3" set:html={copy['g.d3']} />
        </li>
        <li style="--c:#7FA3B8">
          <b data-i18n="g.n4" set:html={copy['g.n4']} />
          <i>Euthynnus affinis</i>
          <span data-i18n="g.d4" set:html={copy['g.d4']} />
        </li>
        <li style="--c:#3E6B80">
          <b data-i18n="g.n5" set:html={copy['g.n5']} />
          <i>Mobula alfredi</i>
          <span data-i18n="g.d5" set:html={copy['g.d5']} />
        </li>
        <li style="--c:#8FF0E8">
          <b data-i18n="g.n6" set:html={copy['g.n6']} />
          <i>Myctophidae</i>
          <span data-i18n="g.d6" set:html={copy['g.d6']} />
        </li>
      </ul>
    </div>
  </div>
</section>
