---
import { id as copy } from '../content/translations';
---

<section class="band" id="fitur" data-depth="20" aria-labelledby="h-feat">
  <div class="wrap">
    <div class="band-head">
      <div class="depth">
        −20 m<small data-i18n="zone.epi" set:html={copy['zone.epi']} />
      </div>
      <div>
        <h2 id="h-feat" data-i18n="feat.title" set:html={copy['feat.title']} />
        <p data-i18n="feat.lead" set:html={copy['feat.lead']} />
      </div>
    </div>
    <div class="features">
      <article class="card span2 reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0zM5 11a7 7 0 0 0 14 0M12 18v3" />
          </svg>
        </div>
        <h3 data-i18n="f1.t" set:html={copy['f1.t']} />
        <p data-i18n="f1.d" set:html={copy['f1.d']} />
        <pre
          class="mini-term"
          tabindex="0"
        ><span class="c" data-i18n="f1.c1" set:html={copy['f1.c1']} />
<span data-i18n="f1.c2" set:html={copy['f1.c2']} />
<span class="c" data-i18n="f1.c3" set:html={copy['f1.c3']} />
<span class="p" data-i18n="f1.c4" set:html={copy['f1.c4']} /></pre>
      </article>
      <article class="card reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 5h18v16H3zM3 10h18M8 3v4M16 3v4" />
          </svg>
        </div>
        <h3 data-i18n="f2.t" set:html={copy['f2.t']} />
        <p data-i18n="f2.d" set:html={copy['f2.d']} />
      </article>
      <article class="card reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM8 12.5l2.7 2.7L16.5 9.5" />
          </svg>
        </div>
        <h3 data-i18n="f3.t" set:html={copy['f3.t']} />
        <p data-i18n="f3.d" set:html={copy['f3.d']} />
      </article>
      <article class="card reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 3h11a2 2 0 0 1 2 2v16H8a2 2 0 0 1-2-2zM6 17a2 2 0 0 1 2-2h11" />
          </svg>
        </div>
        <h3 data-i18n="f4.t" set:html={copy['f4.t']} />
        <p data-i18n="f4.d" set:html={copy['f4.d']} />
      </article>
      <article class="card reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 7h16v12H4zM8 7V5h8v2M4 12h16" />
          </svg>
        </div>
        <h3 data-i18n="f5.t" set:html={copy['f5.t']} />
        <p data-i18n="f5.d" set:html={copy['f5.d']} />
      </article>
      <article class="card span2 reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          </svg>
        </div>
        <h3 data-i18n="f6.t" set:html={copy['f6.t']} />
        <p data-i18n="f6.d" set:html={copy['f6.d']} />
      </article>
      <article class="card span2 reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 17l6-6-6-6M12 19h8" />
          </svg>
        </div>
        <span class="tag" data-i18n="f7.tag" set:html={copy['f7.tag']} />
        <h3 data-i18n="f7.t" set:html={copy['f7.t']} />
        <p data-i18n="f7.d" set:html={copy['f7.d']} />
        <pre
          class="mini-term"
          tabindex="0"
        ><span class="p">$</span> claude mcp add --transport http anchoa \
    https://&lt;ref&gt;.supabase.co/functions/v1/agent-mcp
<span class="c" data-i18n="f7.c1" set:html={copy['f7.c1']} />
<span class="p" data-i18n="f7.c2" set:html={copy['f7.c2']} />
<span class="w" data-i18n="f7.c3" set:html={copy['f7.c3']} /></pre>
      </article>
      <article class="card span2 reveal">
        <div class="ic">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
          </svg>
        </div>
        <h3 data-i18n="f8.t" set:html={copy['f8.t']} />
        <p data-i18n="f8.d" set:html={copy['f8.d']} />
      </article>
    </div>
  </div>
</section>
