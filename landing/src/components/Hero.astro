---
import { id as copy } from '../content/translations';
import { site } from '../config/site';
---

<section class="hero" aria-labelledby="h-hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">
        <span class="dot"></span>
        <span data-i18n="hero.eyebrow" set:html={copy['hero.eyebrow']} />
      </span>
      <h1
        id="h-hero"
        data-i18n-html="hero.title"
        set:html={copy['hero.title']}
      />
      <p class="lead" data-i18n="hero.lead" set:html={copy['hero.lead']} />
      <div class="cta">
        <a class="btn btn-primary" href="#unduh">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
          </svg>
          <span data-i18n="hero.cta1" set:html={copy['hero.cta1']} />
        </a>
        <a
          class="btn btn-ghost js-repo"
          href={site.repository}
          target="_blank"
          rel="noopener"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.4c3-.3 6-1.4 6-6.5a5 5 0 0 0-1.4-3.5 4.6 4.6 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.5 12.5 0 0 0-6.6 0C5.9 1.3 4.8 1.6 4.8 1.6a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 3.3 8.6c0 5.1 3 6.2 6 6.5a3 3 0 0 0-.9 2.4V21" />
          </svg>
          <span data-i18n="hero.cta2" set:html={copy['hero.cta2']} />
        </a>
      </div>
      <p class="hint" data-i18n="hero.hint" set:html={copy['hero.hint']} />
    </div>

    <div class="term" aria-label="Contoh terminal">
      <div class="term-bar">
        <i></i>
        <i></i>
        <i></i>
        <span>~ — bash</span>
      </div>
      <pre><span class="line"><span class="p">$</span> sudo dnf install ./anchoa-*.x86_64.rpm</span><span class="line"><span class="c">Terpasang: anchoa · tauri 2 · svelte 5</span></span><span class="line"><span class="p">$</span> anchoa --rekap</span><span class="line o" data-i18n="term.l1" set:html={copy['term.l1']} /><span class="line o" data-i18n="term.l2" set:html={copy['term.l2']} /><span class="line w" data-i18n="term.l3" set:html={copy['term.l3']} /><span class="line"><span class="p">$</span> <span class="caret"></span></span></pre>
    </div>
  </div>
</section>
