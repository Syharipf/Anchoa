---
import { id as copy } from '../content/translations';
import { assetPath } from '../config/site';
---

<section class="band" id="ponsel" data-depth="40" aria-labelledby="h-mob">
  <div class="wrap">
    <div class="band-head">
      <div class="depth">
        −40 m<small data-i18n="zone.epi" set:html={copy['zone.epi']} />
      </div>
      <div>
        <h2 id="h-mob" data-i18n="mob.title" set:html={copy['mob.title']} />
        <p data-i18n="mob.lead" set:html={copy['mob.lead']} />
      </div>
    </div>

    <div class="mob-row">
      <figure
        class="mob-shot reveal"
        role="img"
        aria-label="Anchoa di HP (rancangan): beranda dengan salam pagi, kartu ringkasan Ako, daftar tugas hari ini, singkat Habits dan Balance, serta dok bawah dengan tombol roda menu di tengah."
      >
        <div class="device">
          <div class="statbar" aria-hidden="true">
            <span class="time">21:14</span>
            <span class="glyphs">
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"
                ><path d="M1 4.2 4 7.2 13 1.5" /><circle cx="12" cy="6" r="1.1" fill="currentColor" stroke="none" /></svg
              >
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"
                ><path d="M1 5.5c2-2.5 5-3.8 8-3.8s6 1.3 8 3.8M3.4 7.6c1.5-1.8 3.5-2.7 5.6-2.7s4.1.9 5.6 2.7M6 9.4c.8-.9 1.9-1.4 3-1.4s2.2.5 3 1.4" /></svg
              >
              <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"
                ><rect x="1" y="1.5" width="17" height="7" rx="1.8" /><rect x="3" y="3.5" width="11" height="3.5" rx=".6" fill="currentColor" stroke="none" /><rect x="19.5" y="3.8" width="1.5" height="2.4" rx=".5" fill="currentColor" stroke="none" /></svg
              >
            </span>
          </div>
          <div class="fit">
            <div class="canvas home" style="--k: 0.6">
              <header class="hdr">
                <div class="hello">
                  <h3>Good morning, Syharipf</h3>
                  <span>Tuesday, 29 September</span>
                </div>
                <span class="iconbtn bell">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M6 8a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6zM10 19a2 2 0 0 0 4 0" /></svg
                  >
                  <i class="dot" aria-hidden="true"></i>
                </span>
              </header>
              <div class="list">
                <section class="card ako">
                  <div class="ako-top">
                  <span class="orb">
                    <span class="school" aria-hidden="true">
                      <svg viewBox="-90 -90 180 180" width="84" height="84" fill="currentColor" aria-hidden="true"
                        ><g transform="rotate(12) translate(0 -56) rotate(-6) scale(0.8)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".32" /></g
                        ><g transform="rotate(48) translate(0 -50) rotate(4) scale(1.0)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".45" /></g
                        ><g transform="rotate(82) translate(0 -58) rotate(-3) scale(0.9)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".55" /></g
                        ><g transform="rotate(116) translate(0 -46) rotate(2) scale(1.05)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".4" /></g
                        ><g transform="rotate(160) translate(0 -54) rotate(-2) scale(0.95)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".5" /></g
                        ><g transform="rotate(208) translate(0 -52) rotate(5) scale(0.85)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".35" /></g
                        ><g transform="rotate(260) translate(0 -50) rotate(-4) scale(1.0)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".45" /></g
                        ><g transform="rotate(312) translate(0 -56) rotate(3) scale(0.9)"><path d="M-7 0c4-2.4 10-2.6 14 0c-4 2.6-10 2.4-14 0zm1 0l-4.5-2.8l1.3 2.8l-1.3 2.8z" fill-opacity=".4" /></g
                      ></svg>
                    </span>
                    <img class="pet bob" src={assetPath('pet/svg/ako-idle.svg')} alt="" aria-hidden="true" />
                  </span>
                  <p>One is overdue: the electricity bill. Want me to log the payment?</p>
                  </div>
                  <span class="pill">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4l13 8-13 8z" /></svg>
                    Listen to recap
                  </span>
                </section>

                <section class="card today">
                  <div class="row-head">
                    <h4>Today</h4>
                    <span class="mono">1/3</span>
                  </div>
                  <ul class="tasks">
                    <li>
                      <span class="box over" aria-hidden="true"></span>
                      <span class="lbl">Pay electricity bill</span>
                      <span class="due coral">overdue</span>
                    </li>
                    <li>
                      <span class="box" aria-hidden="true"></span>
                      <span class="lbl">Send project report</span>
                      <span class="due">18:00</span>
                    </li>
                    <li>
                      <span class="box" aria-hidden="true"></span>
                      <span class="lbl">Call the workshop</span>
                      <span class="due">today</span>
                    </li>
                  </ul>
                </section>

                <div class="grid2">
                  <div class="tile">
                    <span class="lab">Habits</span>
                    <span class="mono big">3<span class="dim"> / 5</span></span>
                    <span class="segs" aria-hidden="true">
                      <i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i>
                    </span>
                  </div>
                  <div class="tile">
                    <span class="lab">Balance</span>
                    <span class="mono">Rp 975.000</span>
                    <span class="warn">Electricity 1 day late</span>
                  </div>
                </div>
              </div>
              <div class="fade" aria-hidden="true"></div>
              <div class="dock" aria-hidden="true">
                <span class="side">
                  <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4-4" /></svg
                  >
                </span>
                <span class="hub">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M3 11l9-7 9 7v9H3z" /><path d="M9 20v-6h6v6" /></svg
                  >
                </span>
                <span class="lbl-home">Home</span>
                <span class="side asst">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M9 6a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0z" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg
                  >
                </span>
              </div>
            </div>
          </div>
        </div>
        <figcaption class="mob-tag">Home · Beranda</figcaption>
      </figure>

      <figure
        class="mob-shot reveal"
        role="img"
        aria-label="Asisten Ako di HP: latar bawah laut dengan Ako berbicara di atasnya, indikator gelombang, balasan singkat, dan mikrofon besar di tengah bawah."
      >
        <div class="device dark">
          <div class="statbar" aria-hidden="true">
            <span class="time">21:14</span>
            <span class="glyphs">
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"
                ><path d="M1 4.2 4 7.2 13 1.5" /><circle cx="12" cy="6" r="1.1" fill="currentColor" stroke="none" /></svg
              >
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"
                ><path d="M1 5.5c2-2.5 5-3.8 8-3.8s6 1.3 8 3.8M3.4 7.6c1.5-1.8 3.5-2.7 5.6-2.7s4.1.9 5.6 2.7M6 9.4c.8-.9 1.9-1.4 3-1.4s2.2.5 3 1.4" /></svg
              >
              <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"
                ><rect x="1" y="1.5" width="17" height="7" rx="1.8" /><rect x="3" y="3.5" width="11" height="3.5" rx=".6" fill="currentColor" stroke="none" /><rect x="19.5" y="3.8" width="1.5" height="2.4" rx=".5" fill="currentColor" stroke="none" /></svg
              >
            </span>
          </div>
          <div class="fit">
            <div class="canvas asst" style="--k: 0.6">
              <header class="hdr asst">
                <span class="iconbtn">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M6 6l12 12M18 6L6 18" /></svg
                  >
                </span>
                <span class="asst-title">Assistant</span>
                <span class="iconbtn">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M4 6h16M4 12h16M4 18h10" /></svg
                  >
                </span>
              </header>
              <div class="stage">
                <img class="laut" src={assetPath('pet/laut.svg')} alt="" aria-hidden="true" />
                <img class="pet bob" src={assetPath('pet/svg/ako-speaking.svg')} alt="" aria-hidden="true" />
              </div>
              <span class="status listen">
                <i class="wave" aria-hidden="true"></i>
                <i class="wave" aria-hidden="true"></i>
                <i class="wave" aria-hidden="true"></i>
                Listening…
              </span>
              <div class="chat">
                <span class="you">You: “log lunch expense 35 thousand”</span>
                <p class="reply">Logged Rp 35,000 for Food, paid in Cash.</p>
                <div class="chips" aria-hidden="true">
                  <span>Change category</span>
                  <span>Undo</span>
                </div>
              </div>
              <div class="mic-row" aria-hidden="true">
                <span class="key">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><rect x="2" y="6" width="20" height="12" rx="2" /><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10" /></svg
                  >
                </span>
                <span class="big-mic coral">
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M9 6a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0z" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg
                  >
                </span>
                <span class="spacer"></span>
              </div>
            </div>
          </div>
        </div>
        <figcaption class="mob-tag">Assistant · Ako</figcaption>
      </figure>

      <figure
        class="mob-shot reveal"
        role="img"
        aria-label="Keuangan di HP: saldo total, arus kas enam bulan, dan transaksi terbaru; dok bawah sama dengan beranda."
      >
        <div class="device">
          <div class="statbar" aria-hidden="true">
            <span class="time">21:14</span>
            <span class="glyphs">
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"
                ><path d="M1 4.2 4 7.2 13 1.5" /><circle cx="12" cy="6" r="1.1" fill="currentColor" stroke="none" /></svg
              >
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"
                ><path d="M1 5.5c2-2.5 5-3.8 8-3.8s6 1.3 8 3.8M3.4 7.6c1.5-1.8 3.5-2.7 5.6-2.7s4.1.9 5.6 2.7M6 9.4c.8-.9 1.9-1.4 3-1.4s2.2.5 3 1.4" /></svg
              >
              <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"
                ><rect x="1" y="1.5" width="17" height="7" rx="1.8" /><rect x="3" y="3.5" width="11" height="3.5" rx=".6" fill="currentColor" stroke="none" /><rect x="19.5" y="3.8" width="1.5" height="2.4" rx=".5" fill="currentColor" stroke="none" /></svg
              >
            </span>
          </div>
          <div class="fit">
            <div class="canvas fin" style="--k: 0.6">
              <header class="hdr">
                <div class="hello">
                  <h3>Finance</h3>
                  <span>September 2026</span>
                </div>
                <span class="iconbtn plus">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M12 5v14M5 12h14" /></svg
                  >
                </span>
              </header>
              <div class="list">
                <section class="card bal">
                  <span class="lab">Balance · all accounts</span>
                  <span class="mono hero">Rp 975.000</span>
                  <div class="two">
                    <div class="kv">
                      <span class="lab">In Sep</span>
                      <span class="mono up">+Rp 2.400.000</span>
                    </div>
                    <div class="kv">
                      <span class="lab">Out Sep</span>
                      <span class="mono down">−Rp 1.425.000</span>
                    </div>
                  </div>
                </section>

                <section class="card flow">
                  <div class="row-head">
                    <h4>Cash flow · 6 months</h4>
                    <span class="legend" aria-hidden="true">
                      <span><i class="dot in"></i>in</span>
                      <span><i class="dot out"></i>out</span>
                    </span>
                  </div>
                  <div class="bars" aria-hidden="true">
                    <span class="bar" style="--in:38;--out:18"><i class="in"></i><i class="out"></i></span>
                    <span class="bar" style="--in:46;--out:22"><i class="in"></i><i class="out"></i></span>
                    <span class="bar" style="--in:54;--out:26"><i class="in"></i><i class="out"></i></span>
                    <span class="bar" style="--in:60;--out:30"><i class="in"></i><i class="out"></i></span>
                    <span class="bar" style="--in:66;--out:34"><i class="in"></i><i class="out"></i></span>
                    <span class="bar now" style="--in:72;--out:40"><i class="in"></i><i class="out"></i></span>
                  </div>
                  <div class="axis mono" aria-hidden="true"><span>Apr</span><span>May</span><span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span></div>
                </section>

                <section class="card tx">
                  <div class="row-head">
                    <h4>Recent transactions</h4>
                    <span class="muted">Sep</span>
                  </div>
                  <ul class="rows">
                    <li>
                      <span class="avatar">MK</span>
                      <span class="meta"><span class="lbl">Makan siang · Warkop B</span><span class="sub">Tue · Cash</span></span>
                      <span class="mono down">−Rp 35.000</span>
                    </li>
                    <li>
                      <span class="avatar">GL</span>
                      <span class="meta"><span class="lbl">Gaji September</span><span class="sub">Mon · Bank BCA</span></span>
                      <span class="mono up">+Rp 2.400.000</span>
                    </li>
                    <li>
                      <span class="avatar">PL</span>
                      <span class="meta"><span class="lbl">Listrik PLN</span><span class="sub">Sat · overdue</span></span>
                      <span class="mono down">−Rp 215.000</span>
                    </li>
                  </ul>
                </section>
              </div>
              <div class="fade" aria-hidden="true"></div>
              <div class="dock" aria-hidden="true">
                <span class="side">
                  <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4-4" /></svg
                  >
                </span>
                <span class="hub">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M3 11l9-7 9 7v9H3z" /><path d="M9 20v-6h6v6" /></svg
                  >
                </span>
                <span class="lbl-home">Home</span>
                <span class="side asst">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    ><path d="M9 6a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0z" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg
                  >
                </span>
              </div>
            </div>
          </div>
        </div>
        <figcaption class="mob-tag">Finance · Keuangan</figcaption>
      </figure>
    </div>

    <p class="mob-cap" data-i18n="mob.caption" set:html={copy['mob.caption']} />
  </div>
</section>

<style>
  /* Section-local layout. Reuses .band, .band-head, .depth, .wrap from global.css. */
  .mob-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    align-items: end;
  }
  .mob-shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .mob-tag {
    font: 500 12px var(--f-mono);
    color: var(--faint);
    letter-spacing: 0.04em;
  }
  .mob-cap {
    margin-top: 28px;
    text-align: center;
    font: 400 12.5px var(--f-mono);
    color: var(--faint);
  }

  /* Phone frame: matches .phone + .dcm-fit in global.css but local so the static section is self-contained. */
  .device {
    position: relative;
    width: 248px;
    padding: 7px 7px 8px;
    border-radius: 30px;
    background: #05090c;
    border: 1px solid #2a3e49;
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(198, 243, 107, 0.06);
  }
  .device.dark {
    background: #04060a;
  }
  .statbar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 16px;
    padding: 0 10px;
    color: #c9ced8;
    font: 600 9.5px var(--f-mono);
  }
  .statbar .time {
    letter-spacing: 0.02em;
  }
  .statbar .glyphs {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #c9ced8;
  }
  .fit {
    position: relative;
    width: 100%;
    aspect-ratio: 390 / 844;
    border-radius: 24px;
    overflow: hidden;
    contain: layout paint;
    background: #0f1115;
  }
  .device.dark .fit {
    background: #0b0d10;
  }

  /* Native 390x844 artboard, scaled down by --k. Mirrors .dcm / .dcm * from global.css. */
  .canvas {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    transform: scale(var(--k, 0.6));
    width: 390px;
    height: 844px;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 16px;
    line-height: normal;
    color: #e7e9ee;
    text-align: left;
    letter-spacing: normal;
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
  }
  .canvas *,
  .canvas *::before,
  .canvas *::after {
    box-sizing: content-box;
  }
  .canvas h1,
  .canvas h2,
  .canvas h3,
  .canvas h4,
  .canvas p {
    margin: 0;
    letter-spacing: normal;
    text-wrap: wrap;
  }
  .canvas.mono,
  .canvas .mono {
    font-family: var(--f-mono);
  }

  /* Top header in artboards. */
  .hdr {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px 10px;
  }
  .hdr.asst {
    padding: 14px 16px 6px;
  }
  .hello {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hello h3 {
    font-family: var(--f-display);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .hello span {
    font-size: 12px;
    color: #9aa3b2;
  }
  .asst-title {
    flex-grow: 1;
    text-align: center;
    font-family: var(--f-display);
    font-size: 16px;
    font-weight: 600;
  }
  .iconbtn {
    position: relative;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    background: #171a21;
    color: #c9ced8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .iconbtn.plus {
    background: #c6f36b;
    color: #0f1115;
  }
  .iconbtn .dot {
    position: absolute;
    top: 9px;
    right: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff8a7a;
    box-shadow: 0 0 0 2px #171a21;
  }

  /* Card list. */
  .list {
