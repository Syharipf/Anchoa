# Maintainer: Syharipf <syharipf@gmail.com>
pkgname=anchoa-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first file manager with a command panel for batch operations'
arch=('x86_64' 'aarch64')
url='https://github.com/Syharipf/Anchoa'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'sqlite' 'gvfs')
makedepends=('cargo' 'git')
provides=('anchoa')
conflicts=('anchoa')
source=("anchoa::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd anchoa
  printf '%s.r%s.g%s' \
    "$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

prepare() {
  cd anchoa
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd anchoa
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd anchoa
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # The trash tests that need a running gvfs are #[ignore]d already.
  cargo test --frozen --release
}

package() {
  cd anchoa
  install -Dm755 target/release/anchoa -t "$pkgdir/usr/bin"
  install -Dm644 data/io.github.syharipf.Anchoa.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 data/io.github.syharipf.Anchoa.metainfo.xml -t "$pkgdir/usr/share/metainfo"
}
